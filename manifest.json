{
  "manifest_version": 3,
  "name": "GestureRead",
  "version": "0.1.0",
  "description": "Adaptive, gesture-controlled reading for any webpage using only your webcam.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "GestureRead",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/helpers.js",
        "utils/math.js",
        "content/overlayController.js",
        "content/gestureEngine.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay/overlay.html", "overlay/overlay.css", "overlay/hud.js"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["assets/mediapipe/*", "assets/mediapipe/wasm/*"],
      "matches": ["<all_urls>"]
    }
  ]
}